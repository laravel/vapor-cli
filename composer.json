{
    "name": "laravel/vapor-cli",
    "description": "The Laravel Vapor CLI",
    "keywords": [
        "laravel",
        "vapor"
    ],
    "homepage": "https://github.com/laravel/vapor-cli",
    "license": "MIT",
    "authors": [
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com"
        }
    ],
    "bin": [
        "vapor"
    ],
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^7.15.2|^8.0.1",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "ramsey/uuid": "^4.7",
        "symfony/console": "^7.4|^8.1",
        "symfony/process": "^7.4.5|^8.1",
        "symfony/var-dumper": "^7.4|^8.1",
        "symfony/yaml": "^7.4.23|^8.1.11",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Laravel\\VaporCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\VaporCli\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
